---
- name: 安装k3s
  hosts: k3sserver
  become: yes
  tasks:
  - name: 更新apt cache
    apt:
      update_cache: yes
  - name: 下载必要组件
    apt:
      name:
      - curl
      - conntrack
      state: present
  - name: 下载k3s
    shell: curl https://get.k3s.io | sh -
    args:
      creates: /usr/local/bin/k3s
  - name: 复制kubeconfig文件至默认位置
    copy:
  
  - name: 验证k3s是否正常运行
    shell: kubectl get nodes
    register: k3s
    changed_when: false
  - name: 显示信息
    debug:
      msg: "{{k3s.stdout}}"
